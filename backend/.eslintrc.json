{
  "extends": "airbnb-base",
  "env": {
    "node": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": 2021
  },
  "rules": {
    "no-console": "off",
    "linebreak-style": "off"
  },
  "overrides": [
  {
    "files": ["tests/**/*.js"],
    "env": {
      "jest": true
    }
  }
]
}