# --------------------------------------------------
# Docker environment variables (example)
# --------------------------------------------------

# NOTE: Do not commit your local .env file.
# Create a local .env file in the frontend/ directory based on this file.

# Database Configuration
# Used by docker-compose.yml for local production testing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your-password-here>
POSTGRES_DB=recruitment

# Frontend API URL
# Used when building frontend for production
# For local testing: http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000